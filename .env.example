# Copy to .env (already gitignored) so you don't have to export this in
# every shell. Both `farsight` and `farsight-mcp` read it.
#
# Precedence, highest first:
#   1. --relay-url on the CLI
#   2. a real environment variable
#   3. this file
#   4. the built-in default (a placeholder that does not resolve)
#
# There is no public relay; see the README's "Running your own relay".
FARSIGHT_RELAY_URL=https://farsight-relay.<your-subdomain>.workers.dev
