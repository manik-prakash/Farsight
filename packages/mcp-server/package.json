{
  "name": "farsight-mcp",
  "version": "0.2.0",
  "description": "farsight-mcp: the MCP server exposing fetch_image, so an agent anywhere with outbound HTTPS can see an image sent via the farsight CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "farsight-mcp": "./bin/farsight-mcp.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/farsight-mcp.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "farsight-core": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manik-prakash/farsight.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/manik-prakash/farsight#readme",
  "bugs": "https://github.com/manik-prakash/farsight/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-agent",
    "vision",
    "screenshot"
  ],
  "author": "Manik Prakash",
  "license": "MIT"
}
